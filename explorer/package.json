{
  "name": "@contextcrucible/explorer",
  "version": "0.4.0",
  "description": "Static explorer that visualises a contextcrucible pack allocation from a manifest.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crucible-explorer": "dist/cli.js"
  },
  "main": "dist/explorer.js",
  "types": "dist/explorer.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/explorer.test.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.3"
  }
}
